# Site origin, used for metadata, canonicals, sitemap, and robots.
# Falls back to the Vercel production URL, then https://localhost:3000.
NEXT_PUBLIC_BASE_URL=https://localhost:3000

# Backend API origin. Defaults to `${NEXT_PUBLIC_BASE_URL}/api`.
NEXT_PUBLIC_BASE_API_URL=https://api.example.com

# NEXT_PUBLIC_* values are inlined into the client bundle. Never put secrets here.
